---
// Habilidades en dos cintas de logos (opción S1, elegida por Jhon el 27/11/2026: "ocupa mucho espacio … que reaccione
// al scroll"; sustituye a las filas por área). Todas las habilidades (SKILLS + STACK) repartidas en dos cintas que se
// mueven en sentidos opuestos SOLO con el scroll: más deprisa si bajas deprisa, cambian de sentido si subes y se paran
// cuando paras (la velocidad se suaviza por tiempo). Al pasar el puntero, la cinta se detiene y el logo toma el color
// de su marca. Cada cinta lleva su contenido dos veces para dar la vuelta sin corte (la copia es aria-hidden).
// Con "reducir movimiento" (o sin JavaScript): quietas, en filas que se parten. Logos: simple-icons (CC0) o propios.
import * as si from 'simple-icons';
import { SKILLS, STACK } from '../data/skills.js';

interface Props { counts: Record<string, number>; }
const { counts } = Astro.props;

const BRAND_FIX: Record<string, string> = { siOpenjdk: 'E76F00' };
const TEXT_COLOR = new Set(['siThreedotjs']);
const OWN: Record<string, string> = {
  datos: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
  estructuras: '<circle cx="12" cy="5" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M11 7.3 7 15.7M13 7.3l4 8.4"/>',
  redes: '<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-4h12v4"/>',
  arquitectura: '<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>',
};
type Logo = { own: boolean; svg: string; hex: string };
const logo = (key: string): Logo | null => {
  if (key.startsWith('propio:')) { const k = key.slice(7); return OWN[k] ? { own: true, svg: OWN[k], hex: '' } : null; }
  const icon = (si as Record<string, { path: string; hex: string }>)[key];
  return icon ? { own: false, svg: `<path d="${icon.path}"/>`, hex: TEXT_COLOR.has(key) ? '' : (BRAND_FIX[key] ?? icon.hex) } : null;
};
const all = [...SKILLS, ...STACK].map((s) => ({ name: s.name, cat: s.cat, logos: (s.logo ?? []).map(logo).filter(Boolean) as Logo[], n: counts[s.name] ?? 0 }));
// Dos cintas: una habilidad a cada lado, alternando (así las áreas quedan mezcladas en las dos)
const rows = [all.filter((_, i) => i % 2 === 0), all.filter((_, i) => i % 2 === 1)];
---
<div class="mq" data-marquee-root>
  {rows.map((row, r) => (
    <div class="mq__row" data-marquee data-dir={r === 0 ? '-1' : '1'}>
      <div class="mq__track">
        {[0, 1].map((copy) => (
          <ul class="mq__set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {row.map((s) => {
              const brand = s.logos.find((l) => !l.own && l.hex)?.hex;
              return (
                <li class="chip" title={s.cat} style={brand ? `--brand: #${brand}` : undefined}>
                  <span class="chip__logos" aria-hidden="true">
                    {s.logos.map((l) => l.own
                      ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={l.svg} />
                      : <svg viewBox="0 0 24 24" fill="currentColor" style={l.hex ? `--c: #${l.hex}` : '--c: var(--text)'} set:html={l.svg} />)}
                  </span>
                  <span class="chip__name">{s.name}</span>
                  {s.n > 0 && <span class="chip__n mono">{s.n}</span>}
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </div>
  ))}
</div>

<script>
  // Movimiento ligado a la VELOCIDAD del scroll (no a su posición): con Lenis la página se desliza y la velocidad sale
  // suave. Bucle rAF solo mientras la sección se ve (IntersectionObserver); sin "reducir movimiento".
  const root = document.querySelector<HTMLElement>('[data-marquee-root]');
  if (root && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    root.classList.add('is-live');
    const rows = [...root.querySelectorAll<HTMLElement>('[data-marquee]')].map((el) => ({
      el, track: el.querySelector<HTMLElement>('.mq__track')!, dir: Number(el.dataset.dir) || 1, x: 0, w: 1, hold: false,
    }));
    const measure = () => rows.forEach((r) => { r.w = (r.track.querySelector('.mq__set') as HTMLElement).offsetWidth || 1; });
    rows.forEach((r) => {
      r.el.addEventListener('pointerenter', () => { r.hold = true; });
      r.el.addEventListener('pointerleave', () => { r.hold = false; });
    });
    let raf = 0, last = 0, lastY = scrollY, vel = 0;
    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      const dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
      const y = scrollY, v = dt > 0 ? (y - lastY) / dt : 0; lastY = y;
      vel += (v - vel) * (1 - Math.exp(-dt * 7)); // px/s del scroll, suavizado
      const speed = Math.max(-900, Math.min(900, vel * 0.55));
      rows.forEach((r) => {
        if (r.hold) return;
        r.x = (((r.x + r.dir * speed * dt) % r.w) + r.w) % r.w;
        r.track.style.transform = `translate3d(${(-r.x).toFixed(1)}px, 0, 0)`;
      });
    };
    const io = new IntersectionObserver((list) => {
      if (list[list.length - 1].isIntersecting) { if (!raf) { last = 0; lastY = scrollY; raf = requestAnimationFrame(loop); } }
      else { cancelAnimationFrame(raf); raf = 0; vel = 0; }
    });
    io.observe(root);
    new ResizeObserver(measure).observe(root);
    measure();
    // Empiezan desplazadas para que no se vea el principio de la lista pegado al borde
    rows.forEach((r, i) => { r.x = r.w * (i ? 0.35 : 0.1); r.track.style.transform = `translate3d(${-r.x}px, 0, 0)`; });
  }
</script>

<style>
  .mq { display: grid; gap: 14px; }
  .mq__row { overflow: hidden; -webkit-mask: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); mask: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .mq__track { display: flex; width: max-content; will-change: transform; }
  .mq__set { list-style: none; margin: 0; padding: 0 14px 0 0; display: flex; gap: 14px; }
  .chip {
    --brand: var(--accent-ink);
    position: relative; display: inline-flex; align-items: center; gap: 12px; height: 64px; padding: 0 22px 0 16px; border-radius: 16px;
    background: var(--surface); border: 1px solid var(--line); color: var(--muted-2); white-space: nowrap;
    transition: border-color 0.25s, color 0.25s, background-color 0.25s;
  }
  .chip__logos { display: flex; gap: 8px; }
  .chip__logos svg { width: 28px; height: 28px; --c: var(--brand); transition: color 0.25s; }
  .chip__name { font: 500 16px var(--sans); color: var(--text); }
  .chip__n { font-size: 11px; padding: 2px 7px; border-radius: 999px; background: rgba(var(--accent-rgb), 0.14); color: var(--accent-ink); }
  @media (hover: hover) {
    .chip:hover { border-color: color-mix(in srgb, var(--brand) 45%, var(--line)); background: color-mix(in srgb, var(--brand) 7%, var(--surface)); }
    .chip:hover .chip__logos svg { color: color-mix(in srgb, var(--c) 82%, var(--text)); }
  }
  @media (hover: none) { .chip__logos svg { color: color-mix(in srgb, var(--c) 82%, var(--text)); } }
  /* Quietas (sin JavaScript o con "reducir movimiento"): sin la copia y en filas que se parten */
  .mq:not(.is-live) .mq__row { -webkit-mask: none; mask: none; }
  .mq:not(.is-live) .mq__track { width: auto; }
  .mq:not(.is-live) .mq__set { flex-wrap: wrap; padding: 0; }
  .mq:not(.is-live) .mq__set[aria-hidden] { display: none; }
  @media (max-width: 760px) { .chip { height: 54px; padding: 0 16px 0 12px; } .chip__name { font-size: 14.5px; } .chip__logos svg { width: 24px; height: 24px; } }
</style>
