---
// Portada de la web nueva (fase 1 de PLAN-REESCRITURA.md): todo es HTML estático salvo la mascota (isla de React).
// Los datos salen de src/data/profile.js y skills.js; los [MARCADORES] los completa Jhon.
import Base from '../layouts/Base.astro';
import HeroMascot from '../components/HeroMascot.jsx';
import Showcase from '../astro/Showcase.astro';
import SkillLogos from '../astro/SkillLogos.astro';
import { getCollection } from 'astro:content';
import { profile, education } from '../data/profile.js';
import { SKILLS, STACK } from '../data/skills.js';
import { externalLink, localLink, isReal } from '../lib/links.js';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const accent = profile.hero.accent.replace('{name}', profile.name);
const isCurrent = (e) => /presente/i.test(e.date);
const hasEmail = isReal(profile.email) && profile.email.includes('@');
// Redes de Contacto con su logo (simple-icons; LinkedIn y el CV, dibujados: LinkedIn no está en simple-icons).
// hex = color de la marca al pasar el puntero (null = el del texto: GitHub y TikTok son negros)
const brandSvg = (icon) => `<path fill="currentColor" d="${icon.path}"/>`;
const LINKS = [
  { key: 'github', label: 'GitHub', url: profile.github, svg: brandSvg(si.siGithub), hex: null },
  { key: 'linkedin', label: 'LinkedIn', url: profile.linkedin, hex: '0A66C2',
    svg: '<path fill="currentColor" d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5ZM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1Zm1.8 13.1H3.6V9h3.5Z"/>' },
  { key: 'cv', label: 'CV', url: profile.cvUrl, local: true, hex: null,
    svg: '<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Zm0 0v5h5M9 13h6M9 17h4"/>' },
  { key: 'youtube', label: 'YouTube', url: profile.youtube, svg: brandSvg(si.siYoutube), hex: 'FF0000' },
  { key: 'instagram', label: 'Instagram', url: profile.instagram, svg: brandSvg(si.siInstagram), hex: 'FF0069' },
  { key: 'tiktok', label: 'TikTok', url: profile.tiktok, svg: brandSvg(si.siTiktok), hex: null },
];
// Proyectos: colección de Markdown (src/content/proyectos/), en el orden de `order`
const list = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
// Habilidades: en cuántos proyectos REALES aparece cada una (los que aún son plantilla, con [CORCHETES], no cuentan)
const realProjects = list.filter((p) => !p.data.title.includes('['));
const usedIn = (name) => realProjects.filter((p) => p.data.tags.some((t) => t.toLowerCase() === name.toLowerCase())).length;
const skillCounts = Object.fromEntries([...SKILLS, ...STACK].map((s) => [s.name, usedIn(s.name)]));
import MiniMascot from '../components/MiniMascot.jsx';
import ContactMascot from '../components/ContactMascot.jsx';
import Formacion from '../astro/Formacion.astro';
import * as si from 'simple-icons';
---
<Base>
  <!-- Portada -->
  <section id="inicio" class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="kicker">{profile.hero.kicker}</p>
        <h1><span class="line">{profile.hero.title}</span><span class="line accent">{accent}</span></h1>
        <p class="hero__lead">{profile.role} en la {profile.university}, {profile.city}. {profile.bio}</p>
        <div class="hero__cta">
          <a class="btn btn--accent" href="#proyectos">Ver proyectos<span class="arr" aria-hidden="true">↓</span></a>
          <a class="btn btn--ghost" {...localLink(profile.cvUrl)} download={isReal(profile.cvUrl) ? '' : undefined}>Descargar CV</a>
        </div>
      </div>
      <div class="hero__stage" aria-label="Mascota robot de TrzJhonDev">
        <div class="hero__panel" aria-hidden="true"></div>
        <HeroMascot client:only="react">
          <div class="hero-bot" slot="fallback">
            <img class="hero-bot__img hero-bot__img--dark" src={`${BASE}/img/mascota-dormida-oscuro.webp`} alt="" width="680" height="907" fetchpriority="high" />
            <img class="hero-bot__img hero-bot__img--light" src={`${BASE}/img/mascota-dormida-claro.webp`} alt="" width="680" height="907" />
          </div>
        </HeroMascot>
      </div>
    </div>
  </section>

  <!-- Proyectos: vitrina con la captura fija que cambia mientras bajas (Showcase.astro) -->
  <section id="proyectos" class="section">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <p class="kicker">~/programas — {list.length} instalados</p>
        <h2>Proyectos</h2>
        <p>Lo que he construido: qué problema resuelve cada uno, cómo lo hice y con qué.</p>
      </header>
      <Showcase list={list} />
    </div>
  </section>

  <!-- Habilidades -->
  <section id="habilidades" class="section">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <p class="kicker">$ skills --list</p>
        <h2>Habilidades</h2>
        <p>Las herramientas con las que trabajo, por áreas. En <a href={`${BASE}/lab/`}>el laboratorio</a> puedes probarlas en el portátil 3D.</p>
      </header>
      <SkillLogos counts={skillCounts} />
    </div>
  </section>

  <!-- Formación -->
  <section id="formacion" class="section">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <p class="kicker">historial de versiones</p>
        <h2>Formación</h2>
      </header>
      <Formacion />
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="section">
    <div class="wrap">
      <div class="contact">
        <div class="contact__main">
        <header class="section__head" data-reveal>
          <p class="kicker">&gt; abrir conexión</p>
          <h2>Contacto</h2>
          <p>Busco prácticas y proyectos donde aprender. Escríbeme y te respondo.</p>
        </header>
        <div class="contact__mail">
          <span class="mono contact__addr" class:list={[{ pending: !hasEmail }]}>{profile.email}</span>
          {hasEmail
            ? <button type="button" class="btn btn--accent" data-copy={profile.email}>Copiar correo</button>
            : <span class="btn" aria-disabled="true">Correo pendiente</span>}
          <span class="contact__status" role="status" aria-live="polite"></span>
        </div>
        <form class="contact__form" data-mailto={hasEmail ? profile.email : ''} novalidate>
          <label for="mensaje">Tu mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="4" placeholder="Hola Jhon, me gustaría…" data-lenis-prevent required></textarea>
          <p class="contact__hint" id="mensaje-error" role="alert"></p>
          <div class="contact__send">
            {hasEmail
              ? <button type="submit" class="btn btn--accent">Enviar por correo</button>
              : <span class="btn" aria-disabled="true">Envío pendiente: falta el correo</span>}
            <span class="contact__note">Se abre tu programa de correo con el texto listo; no hay servidor.</span>
          </div>
        </form>
        </div>
        <!-- La mascota "cartera": mira tu mensaje y celebra al enviarlo (ContactMascot.jsx; la pequeña se aparta mientras se ve) -->
        <div class="contact__stage" data-contact-bot>
          <div class="contact__panel" aria-hidden="true"></div>
          <ContactMascot client:visible />
        </div>
        <ul class="contact__socials">
          {LINKS.map((l) => {
            const real = isReal(l.url);
            return (
              <li style={l.hex ? `--brand: #${l.hex}` : undefined}>
                <a class:list={['social', { 'is-pending': !real }]} {...(l.local ? localLink(l.url) : externalLink(l.url))}>
                  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" set:html={l.svg} />
                  <span class="social__name">{l.label}</span>
                  <span class="mono social__state">{real ? '↗' : 'pendiente'}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>
  <MiniMascot client:only="react" />
</Base>

<script>
  // C · Títulos que se revelan: al entrar en pantalla, la línea de consola se "escribe" y el título sube desde abajo,
  // una sola vez. Las clases las pone este script (sin JavaScript se ve todo); con "reducir movimiento", nada.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver((list) => list.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  }

  // Formulario: abre el programa de correo con asunto y texto (sin servidor). Si está vacío, lo dice junto al campo.
  const form = document.querySelector<HTMLFormElement>('.contact__form');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const to = form.dataset.mailto;
    const text = (form.querySelector('textarea') as HTMLTextAreaElement).value.trim();
    const err = document.getElementById('mensaje-error');
    if (!text) { if (err) err.textContent = 'Escribe tu mensaje antes de enviarlo.'; form.querySelector('textarea')?.focus(); return; }
    if (err) err.textContent = '';
    window.dispatchEvent(new CustomEvent('mascota:celebrar'));
    if (to) location.href = `mailto:${to}?subject=${encodeURIComponent('Contacto desde tu portafolio')}&body=${encodeURIComponent(text)}`;
  });
  form?.querySelector('textarea')?.addEventListener('input', () => { const err = document.getElementById('mensaje-error'); if (err) err.textContent = ''; });

  // Copiar el correo (con aviso accesible; si el portapapeles falla, se selecciona el texto)
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      const status = document.querySelector('.contact__status');
      try { await navigator.clipboard.writeText(b.dataset.copy!); if (status) status.textContent = 'Correo copiado'; }
      catch {
        const addr = document.querySelector('.contact__addr');
        if (addr) { const r = document.createRange(); r.selectNodeContents(addr); getSelection()?.removeAllRanges(); getSelection()?.addRange(r); }
        if (status) status.textContent = 'Selecciona y copia el correo';
      }
      setTimeout(() => { if (status) status.textContent = ''; }, 2500);
    });
  });
</script>

<style>
  /* Portada: texto a la izquierda, la mascota a la derecha sobre su halo */
  .hero { position: relative; min-height: min(100svh, 920px); display: grid; align-items: center; padding-block: 120px 56px; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(24px, 4vw, 56px); align-items: center; width: 100%; }
  .hero__text { display: grid; gap: 22px; }
  .hero h1 { font-size: clamp(46px, 6.4vw, 84px); }
  .hero .line { display: block; white-space: nowrap; }
  .hero .accent { color: var(--accent-ink); }
  .hero__lead { color: var(--muted); font-size: 18.5px; max-width: 52ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hero__stage { position: relative; width: min(100%, 440px); justify-self: center; aspect-ratio: 3 / 4; }
  /* Escenario de la mascota: un panel con su luz (en claro, azul noche: el marfil sobre crema casi no se veía) */
  .hero__panel { position: absolute; transform-origin: 50% 70%; inset: 14% 0 3% 0; border-radius: 32px; pointer-events: none; background: var(--stage-glow), var(--stage-panel); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 30px 80px -40px rgba(0, 0, 0, 0.6); }
  :global(.hero-bot) { position: absolute; inset: 0; }
  :global(.hero-bot__img) { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity 0.5s var(--ease); }
  :global(.hero-bot__img--light) { display: none; }
  :global([data-theme="light"] .hero-bot__img--dark) { display: none; }
  :global([data-theme="light"] .hero-bot__img--light) { display: block; }
  :global(.hero-bot.is-ready .hero-bot__img) { opacity: 0; }
  @media (max-width: 860px) {
    .hero { min-height: 0; padding-top: 104px; }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__stage { width: min(78vw, 340px); order: -1; }
  }


  /* A · Portada. Entrada al cargar: la línea de consola, cada renglón del titular, el texto y los botones, escalonados;
     el panel y la mascota aparecen a la vez. Salida con el scroll (CSS scroll-driven): el texto sube y se apaga antes,
     la mascota se aleja más despacio (profundidad). Solo transform y opacity; con "reducir movimiento", nada. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__text > *, .hero .line { animation: enter 0.75s var(--ease) both; }
    .hero__text > .kicker { animation-delay: 0.05s; }
    .hero .line:first-child { animation-delay: 0.14s; }
    .hero .line:last-child { animation-delay: 0.26s; }
    .hero__text > h1 { animation: none; }
    .hero__lead { animation-delay: 0.4s !important; }
    .hero__cta { animation-delay: 0.52s !important; }
    .hero__panel, :global(.hero-bot) { animation: enter-stage 0.9s var(--ease) 0.1s both; }
    @supports (animation-timeline: view()) {
      .hero__text { animation: hero-out linear both; animation-timeline: view(); animation-range: exit 5% exit 85%; }
      .hero__stage { animation: stage-out linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
    }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(0.45em); } }
  @keyframes enter-stage { from { opacity: 0; transform: translateY(18px) scale(0.97); } }
  @keyframes hero-out { to { opacity: 0; transform: translateY(-48px); } }
  @keyframes stage-out { to { opacity: 0.35; transform: translateY(64px) scale(0.94); } }
  .btn .arr { display: inline-block; transition: transform 0.2s var(--ease); }
  @media (hover: hover) { .btn:hover .arr { transform: translateY(2px); } }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font: 500 13px var(--mono); padding: 4px 11px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--muted); }

  /* Habilidades: logos en src/astro/SkillLogos.astro */

  /* Formación: tarjetas en src/astro/Formacion.astro */
  .cursor-blink { animation: blink 1.2s steps(2, jump-none) infinite; }
  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.15; } }

  /* Contacto */
  .contact { padding: clamp(28px, 5vw, 56px); border-radius: 22px; background: var(--surface); border: 1px solid var(--line); }
  .contact .section__head { margin-bottom: 28px; }
  .contact { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 24px clamp(24px, 4vw, 56px); align-items: center; }
  .contact__main { min-width: 0; }
  .contact__stage { position: relative; aspect-ratio: 3 / 4; width: min(100%, 340px); justify-self: center; }
  :global(.contact-bot) { position: absolute; inset: 0; }
  .contact__panel { position: absolute; inset: 14% 0 3% 0; border-radius: 28px; background: var(--stage-glow), var(--stage-panel); }
  .contact__socials { grid-column: 1 / -1; list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .social {
    --brand-c: var(--text);
    display: grid; justify-items: center; gap: 8px; padding: 18px 12px 14px; border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--bg); color: var(--muted-2); text-decoration: none; text-align: center; transition: translate 0.25s var(--ease), border-color 0.25s, color 0.25s;
  }
  .contact__socials li[style] .social { --brand-c: color-mix(in srgb, var(--brand) 82%, var(--text)); }
  .social svg { width: 28px; height: 28px; }
  .social__name { font: 500 14.5px var(--sans); color: var(--text); }
  .social__state { font-size: 11.5px; color: var(--muted-2); }
  .social.is-pending { border-style: dashed; border-color: var(--line-2); cursor: not-allowed; }
  @media (hover: hover) {
    .social:not(.is-pending):hover { translate: 0 -2px; color: var(--brand-c); border-color: color-mix(in srgb, var(--brand-c) 45%, var(--line)); }
  }
  @media (hover: none) { .social { color: var(--brand-c); } }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } .contact__stage { width: min(70vw, 280px); } }
  .contact__mail { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .contact__addr { font-size: clamp(17px, 2.2vw, 22px); word-break: break-all; }
  .contact__status { font-size: 14px; color: var(--accent-ink); min-height: 1em; }
  .contact__form { display: grid; gap: 10px; margin-top: 32px; max-width: 640px; }
  .contact__form label { font: 600 15px var(--sans); }
  .contact__form textarea { width: 100%; resize: vertical; min-height: 110px; padding: 12px 14px; border-radius: 12px; font: 400 16px/1.5 var(--sans); color: var(--text); background: var(--bg); border: 1px solid var(--line-2); }
  .contact__form textarea::placeholder { color: var(--muted-2); }
  .contact__form textarea:focus { outline: none; border-color: var(--accent-ink); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.18); }
  .contact__hint { min-height: 1.2em; font-size: 14px; color: var(--danger); }
  .contact__send { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .contact__note { font-size: 14px; color: var(--muted-2); }
</style>
