---
// Laboratorio: una ventana con pestañas (Portátil, Consola, Switch) y la misma franja de información en las tres
// (LabApp.jsx, una sola isla de React). Decisiones de Jhon del 27/11/2026: fuera de la portada (a un clic desde la
// barra) y, después, ordenado como una ventana con pestañas (opción L1).
import Base from '../../layouts/Base.astro';
import LabApp from '../../components/LabApp.jsx';
import { getCollection } from 'astro:content';

// Los proyectos de la colección, con la forma que espera la lista de programas del portátil
const projects = (await getCollection('proyectos'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ title: p.data.title, description: p.data.summary, tags: p.data.tags, image: p.data.image, code: p.data.code, demo: p.data.demo }));
---
<Base title="Laboratorio — TrzJhonDev" description="Laboratorio de TrzJhonDev: un portátil 3D interactivo, la consola de juegos de la mascota y un switch de puertos con cable.">
  <div class="wrap">
    <header class="lab-intro">
      <h1>Laboratorio</h1>
      <p>Tres piezas interactivas hechas con CSS 3D, Three.js y modelos de Blender. Elige una y pruébala; los proyectos están en <a href="/#proyectos">la portada</a>.</p>
    </header>
  </div>
  <LabApp client:only="react" projects={projects}>
    <p slot="fallback" class="wrap lab-loading mono">Cargando el laboratorio…</p>
  </LabApp>
</Base>

<style>
  /* Cabecera compacta (Jhon: "desplaza mucho la página y se ve vacía"): sin el "~/lab" de encima (ya lo dice la barra de
     la ventana); en escritorio el título y el texto en una sola fila, alineados abajo */
  .lab-intro { padding-top: 136px; display: grid; grid-template-columns: auto minmax(0, 520px); justify-content: space-between; align-items: end; gap: 14px 56px; margin-bottom: 44px; }
  .lab-intro h1 { font-size: clamp(38px, 4.6vw, 58px); line-height: 1; }
  .lab-intro p { color: var(--muted); font-size: 16.5px; line-height: 1.55; }
  /* El pie, más cerca de la ventana (en la portada lleva 140 px de aire; aquí dejaba un hueco vacío) */
  :global(.foot) { margin-top: 56px; }
  @media (max-width: 900px) { .lab-intro { grid-template-columns: 1fr; padding-top: 112px; margin-bottom: 30px; } }
  .lab-loading { padding-block: 80px; color: var(--muted-2); }

  /* Pestañas */
  :global(.lab__tabs) { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  :global(.lab__tab) {
    display: inline-flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 18px; border-radius: 12px; cursor: pointer;
    font: 600 15px var(--sans); color: var(--muted); background: transparent; border: 1px solid var(--line-2);
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  :global(.lab__tab:hover) { color: var(--text); border-color: var(--muted-2); }
  :global(.lab__tab.is-on) { color: var(--text); background: var(--surface); border-color: var(--accent-ink); box-shadow: inset 0 -2px 0 var(--accent-ink); }
  :global(.lab__tab-n) { font-size: 12px; color: var(--muted-2); }
  :global(.lab__tab.is-on .lab__tab-n) { color: var(--accent-ink); }

  /* Ventana */
  :global(.lab__win) { border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 30px 80px -50px rgba(0, 0, 0, 0.55); }
  :global(.lab__bar) { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid var(--line); background: var(--surface-2); }
  :global(.lab__bar i) { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); }
  :global(.lab__bar span) { margin-left: 10px; font-size: 13px; color: var(--muted-2); }
  :global(.lab__view) { position: relative; height: clamp(540px, 72vh, 700px); overflow: hidden; background: var(--bg); animation: lab-in 0.35s var(--ease); }
  @keyframes lab-in { from { opacity: 0; } }

  /* Portátil: la sección vieja llena la vista; sin su título ni la pista fijada */
  :global(.lab__view--portatil .lab-laptop), :global(.lab__view--portatil .work) { height: 100%; min-height: 0; }
  :global(.lab__view--portatil .work__head) { display: none; }
  :global(.lab__view--portatil .work__col) { padding-top: 32px; }
  /* Sin la etiqueta de la habilidad ("Python · Lenguajes") que salía al pulsar una tecla (Jhon, 27/11/2026) */
  :global(.lab__view--portatil .stage__skill) { display: none; }
  /* Consola: la mascota grande en el centro */
  :global(.lab-console) { height: 100%; display: grid; place-items: center; background: radial-gradient(50% 55% at 50% 45%, rgba(var(--accent-rgb), 0.12), transparent 70%); }
  :global(.lab-console__bot) { position: relative; height: 92%; aspect-ratio: 3 / 4; }
  /* Switch: el escenario sin el marco del bloque de Contacto */
  :global(.lab__view--switch) { overflow-y: auto; height: auto; min-height: clamp(540px, 72vh, 700px); }
  :global(.lab__view--switch #switch) { padding: 24px 0 0; max-width: none; }
  :global(.lab__view--switch .cta) { border: 0; background: transparent; border-radius: 0; padding: 8px 0 0; }

  /* Franja de información. PRIMERO, a todo el ancho, los controles (Jhon: "los controles deberían ir primero"); debajo
     "qué es" y "hecho con". Los controles son tarjetas: primero
     QUÉ consigues (en negrita) y debajo CÓMO (con las teclas como teclas), con un icono del gesto que se anima al pasar
     el puntero (el cursor arrastra, el clic hace onda, la tecla baja, la rueda gira). Las tarjetas entran escalonadas al
     abrir la pestaña. Nada de esto se mueve con "reducir movimiento". */
  :global(.lab__info) {
    display: grid; grid-template-columns: minmax(0, 1fr) max-content; grid-template-areas: 'ctrl ctrl' 'about made';
    gap: 30px clamp(40px, 5vw, 80px); align-items: start; padding: 30px clamp(20px, 3vw, 40px) 36px; border-top: 1px solid var(--line);
  }
  :global(.lab__about) { grid-area: about; display: grid; gap: 12px; align-content: start; max-width: 68ch; }
  :global(.lab__about p) { color: var(--muted); font-size: 15.5px; line-height: 1.6; }
  :global(.lab__tip) { font-size: 14px !important; color: var(--accent-ink) !important; padding-left: 12px; border-left: 2px solid var(--accent-ink); }
  :global(.lab__h) { font-size: 12.5px; font-weight: 500; letter-spacing: 0.02em; color: var(--muted-2); margin: 0 0 14px; line-height: 1.4; }
  :global(.lab__about .lab__h) { margin-bottom: 2px; }
  :global(.lab__ctrl) { grid-area: ctrl; }
  :global(.lab__about), :global(.lab__made-col) { padding-top: 26px; border-top: 1px dashed var(--line); }
  :global(.lab__made-col) { grid-area: made; }

  /* Tarjetas de control */
  :global(.lab__ctls) { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  :global(.lab__ctl) {
    display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--bg);
    transition: border-color 0.25s, background-color 0.25s, translate 0.25s var(--ease);
  }
  :global(.lab__ctl-ico) {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px;
    color: var(--accent-ink); background: rgba(var(--accent-rgb), 0.1); transition: background-color 0.25s;
  }
  :global(.lab__ctl-ico svg) { overflow: visible; }
  :global(.lab__ctl-txt) { display: grid; gap: 5px; min-width: 0; }
  :global(.lab__ctl-txt strong) { font: 600 15px/1.3 var(--sans); color: var(--text); }
  :global(.lab__ctl-how) { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; font-size: 13.5px; line-height: 1.4; color: var(--muted); }
  :global(.lab__ctl-how kbd) { font: 500 12px/1 var(--mono); padding: 4px 7px 3px; border-radius: 6px; border: 1px solid var(--line-2); background: var(--surface-2); color: var(--text); box-shadow: 0 2px 0 var(--line-2); }

  /* "Hecho con": fichas que toman el borde de su marca al pasar */
  :global(.lab__made) { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; max-width: 300px; }
  :global(.lab__made li) {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px 7px 9px; border-radius: 999px; border: 1px solid var(--line);
    font-size: 14px; color: var(--text); transition: border-color 0.25s, background-color 0.25s;
  }
  :global(.lab__made svg) { width: 18px; height: 18px; color: color-mix(in srgb, var(--brand) 80%, var(--text)); transition: transform 0.35s var(--ease); }

  @media (hover: hover) {
    :global(.lab__ctl:hover) { border-color: color-mix(in srgb, var(--accent-ink) 45%, var(--line)); background: var(--surface-2); translate: 0 -2px; }
    :global(.lab__ctl:hover .lab__ctl-ico) { background: rgba(var(--accent-rgb), 0.18); }
    :global(.lab__made li:hover) { border-color: color-mix(in srgb, var(--brand) 50%, var(--line)); background: color-mix(in srgb, var(--brand) 7%, transparent); }
    :global(.lab__made li:hover svg) { transform: scale(1.15) rotate(-6deg); }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrada escalonada al abrir la pestaña (solo opacidad y posición) */
    :global(.lab__ctl) { animation: ctl-in 0.45s var(--ease) both; animation-delay: calc(var(--i) * 55ms + 80ms); }
    @keyframes ctl-in { from { opacity: 0; transform: translateY(8px); } }
    /* Cada gesto, en bucle mientras el puntero está encima; en táctil se ve una vez al entrar */
    :global(.lab__ctl .m) { transform-box: fill-box; transform-origin: center; }
    :global(.lab__ctl .m) { animation-duration: 1.4s; animation-timing-function: ease-in-out; animation-iteration-count: 1; animation-delay: calc(var(--i) * 55ms + 400ms); }
    :global(.lab__ctl--drag .m), :global(.lab__ctl--grab .m) { animation-name: g-drag; }
    :global(.lab__ctl--dragY .m) { animation-name: g-dragy; }
    :global(.lab__ctl--click .m) { animation-name: g-ripple; }
    :global(.lab__ctl--key .m), :global(.lab__ctl--pad .m) { animation-name: g-press; }
    :global(.lab__ctl--wheel .m) { animation-name: g-wheel; }
    :global(.lab__ctl--point .m) { animation-name: g-point; }
    :global(.lab__ctl--arrows .m) { animation-name: g-blink; animation-duration: 1.6s; }
    :global(.lab__ctl--arrows .a2) { animation-delay: calc(var(--i) * 55ms + 600ms); }
    :global(.lab__ctl--arrows .a3) { animation-delay: calc(var(--i) * 55ms + 800ms); }
    :global(.lab__ctl--arrows .a4) { animation-delay: calc(var(--i) * 55ms + 1000ms); }
    @media (hover: hover) {
      :global(.lab__ctl:hover .m) { animation-iteration-count: infinite; animation-delay: 0s; }
      :global(.lab__ctl--arrows:hover .a2) { animation-delay: 0.2s; }
      :global(.lab__ctl--arrows:hover .a3) { animation-delay: 0.4s; }
      :global(.lab__ctl--arrows:hover .a4) { animation-delay: 0.6s; }
    }
    @keyframes g-drag { 0%, 100% { transform: translateX(0); } 30% { transform: translateX(-4px); } 70% { transform: translateX(4px); } }
    @keyframes g-dragy { 0%, 100% { transform: translateY(0); } 30% { transform: translateY(-4px); } 70% { transform: translateY(4px); } }
    @keyframes g-ripple { 0% { transform: scale(0.3); opacity: 0.9; } 70%, 100% { transform: scale(1.25); opacity: 0; } }
    @keyframes g-press { 0%, 45%, 100% { transform: translateY(0); } 20% { transform: translateY(2px); } }
    @keyframes g-wheel { 0% { transform: translateY(-1px); opacity: 1; } 70% { transform: translateY(4px); opacity: 0; } 100% { transform: translateY(-1px); opacity: 0; } }
    @keyframes g-point { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(5px, -3px); } }
    @keyframes g-blink { 0%, 100% { opacity: 0.35; } 15% { opacity: 1; } 40% { opacity: 0.35; } }
  }

  /* Ventana media: los controles en dos columnas */
  @media (max-width: 1180px) {
    :global(.lab__ctls) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    :global(.lab__info) { grid-template-columns: 1fr; grid-template-areas: 'ctrl' 'about' 'made'; gap: 28px; }
    :global(.lab__made-col) { padding-top: 0; border-top: 0; }
    :global(.lab__ctls) { grid-template-columns: 1fr; }
    :global(.lab__made) { max-width: none; }
    :global(.lab__tabs) { flex-wrap: nowrap; gap: 6px; }
    :global(.lab__tab) { flex: 1; justify-content: center; padding: 0 10px; font-size: 14px; gap: 6px; }
    :global(.lab__view) { height: auto; min-height: 520px; }
    :global(.lab__view--portatil .work) { height: auto; }
    :global(.lab-console) { height: 520px; }
  }
</style>
